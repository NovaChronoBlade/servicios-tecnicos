generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model calificaciones {
  id_calificacion                              String              @id @db.VarChar(50)
  id_tecnico                                   String              @db.VarChar(50)
  id_cliente                                   String              @db.VarChar(50)
  id_ss                                        String              @db.VarChar(50)
  puntuacion                                   Int
  comentario                                   String?             @db.VarChar(500)
  fecha_calificacion                           DateTime            @default(now()) @db.Timestamp(6)
  usuarios_calificaciones_id_clienteTousuarios usuarios            @relation("calificaciones_id_clienteTousuarios", fields: [id_cliente], references: [id_usuario], map: "fk_cal_cliente")
  solicitud_servicios                          solicitud_servicios @relation(fields: [id_ss], references: [id_ss], map: "fk_cal_ss")
  usuarios_calificaciones_id_tecnicoTousuarios usuarios            @relation("calificaciones_id_tecnicoTousuarios", fields: [id_tecnico], references: [id_usuario], map: "fk_cal_tecnico")
}

model comentarios {
  id_comentario                             String              @id @db.VarChar(50)
  id_tecnico                                String              @db.VarChar(50)
  id_cliente                                String              @db.VarChar(50)
  id_ss                                     String              @db.VarChar(50)
  contenido                                 String              @db.VarChar(500)
  fecha_comentario                          DateTime            @default(now()) @db.Timestamp(6)
  usuarios_comentarios_id_clienteTousuarios usuarios            @relation("comentarios_id_clienteTousuarios", fields: [id_cliente], references: [id_usuario], map: "fk_com_cliente")
  solicitud_servicios                       solicitud_servicios @relation(fields: [id_ss], references: [id_ss], map: "fk_com_ss")
  usuarios_comentarios_id_tecnicoTousuarios usuarios            @relation("comentarios_id_tecnicoTousuarios", fields: [id_tecnico], references: [id_usuario], map: "fk_com_tecnico")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalles_tecnicos {
  id_usuario            String   @id @db.VarChar(50)
  especialidad          String   @db.VarChar(100)
  licencia_profesional  String   @db.VarChar(50)
  disponible            Boolean  @default(true)
  calificacion_promedio Decimal  @default(0.0) @db.Decimal(3, 2)
  usuarios              usuarios @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, map: "fk_detalles_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model disponibilidad_tecnicos {
  id_disponibilidad String   @id @db.VarChar(50)
  id_tecnico        String   @db.VarChar(50)
  dia_semana        Int
  hora_inicio       DateTime @db.Time(6)
  hora_fin          DateTime @db.Time(6)
  activo            Boolean  @default(true)
  nota              String?  @db.VarChar(200)
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @default(now()) @db.Timestamp(6)
  usuarios          usuarios @relation(fields: [id_tecnico], references: [id_usuario], onDelete: Cascade, map: "fk_disponibilidad_tecnico")

  @@unique([id_tecnico, dia_semana, hora_inicio, hora_fin], map: "disponibilidad_tecnicos_bloque_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model direcciones {
  id_direccion        String                @id @db.VarChar(50)
  id_usuario          String                @db.VarChar(50)
  direccion           String                @db.VarChar(200)
  tipo_edificio       String                @db.VarChar(50)
  informacion         String?               @db.VarChar(200)
  nota                String?               @db.VarChar(200)
  es_default          Boolean               @default(false)
  usuarios            usuarios              @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, map: "fk_direcciones_usuario")
  solicitud_servicios solicitud_servicios[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pagos {
  id_pago             String              @id @db.VarChar(50)
  id_ss               String              @unique @db.VarChar(50)
  monto               Decimal             @db.Decimal(10, 2)
  metodo_pago         String              @db.VarChar(50)
  estado              String              @db.VarChar(20)
  numero_referencia   String?             @unique @db.VarChar(50)
  fecha_pago          DateTime            @default(now()) @db.Timestamp(6)
  solicitud_servicios solicitud_servicios @relation(fields: [id_ss], references: [id_ss], map: "fk_pagos_ss")
}

model categorias_servicios {
  id_categoria String      @id @db.VarChar(50)
  nombre       String      @unique @db.VarChar(100)
  descripcion  String?     @db.VarChar(500)
  activo       Boolean     @default(true)
  servicios    servicios[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model servicios {
  id_servicio         String                @id @db.VarChar(50)
  nombre              String                @db.VarChar(100)
  descripcion         String                @db.VarChar(500)
  precio              Decimal               @db.Decimal(10, 2)
  activo              Boolean               @default(true)
  id_categoria        String?               @db.VarChar(50)
  categorias_servicios categorias_servicios? @relation(fields: [id_categoria], references: [id_categoria], map: "fk_servicios_categoria")
  solicitud_servicios solicitud_servicios[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model solicitud_servicios {
  id_ss                                             String           @id @db.VarChar(50)
  id_cliente                                        String           @db.VarChar(50)
  id_tecnico                                        String?          @db.VarChar(50)
  id_servicio                                       String           @db.VarChar(50)
  id_direccion                                      String           @db.VarChar(50)
  estado                                            String           @default("pendiente") @db.VarChar(20)
  confirmacion_cliente                              Boolean          @default(false)
  confirmacion_tecnico                              Boolean          @default(false)
  motivo_cancelacion                                String?          @db.VarChar(500)
  fecha                                             DateTime         @default(now()) @db.Timestamp(6)
  fecha_programada                                  DateTime?        @db.Timestamp(6)
  fecha_aceptacion                                  DateTime?        @db.Timestamp(6)
  fecha_finalizacion                                DateTime?        @db.Timestamp(6)
  calificaciones                                    calificaciones[]
  comentarios                                       comentarios[]
  pagos                                             pagos?
  usuarios_solicitud_servicios_id_clienteTousuarios usuarios         @relation("solicitud_servicios_id_clienteTousuarios", fields: [id_cliente], references: [id_usuario], map: "fk_ss_cliente")
  direcciones                                       direcciones      @relation(fields: [id_direccion], references: [id_direccion], map: "fk_ss_direccion")
  servicios                                         servicios        @relation(fields: [id_servicio], references: [id_servicio], map: "fk_ss_servicio")
  usuarios_solicitud_servicios_id_tecnicoTousuarios usuarios?        @relation("solicitud_servicios_id_tecnicoTousuarios", fields: [id_tecnico], references: [id_usuario], map: "fk_ss_tecnico")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id_usuario                                                   String                @id @db.VarChar(50)
  documento                                                    String                @unique @db.VarChar(20)
  fecha_nacimiento                                             DateTime              @db.Date
  nombre                                                       String                @db.VarChar(100)
  correo                                                       String                @unique @db.VarChar(100)
  contrasena                                                   String                @db.VarChar(255)
  telefono                                                     String                @unique @db.VarChar(20)
  rol                                                          String                @db.VarChar(20)
  activo                                                       Boolean               @default(true)
  calificaciones_calificaciones_id_clienteTousuarios           calificaciones[]      @relation("calificaciones_id_clienteTousuarios")
  calificaciones_calificaciones_id_tecnicoTousuarios           calificaciones[]      @relation("calificaciones_id_tecnicoTousuarios")
  comentarios_comentarios_id_clienteTousuarios                 comentarios[]         @relation("comentarios_id_clienteTousuarios")
  comentarios_comentarios_id_tecnicoTousuarios                 comentarios[]         @relation("comentarios_id_tecnicoTousuarios")
  detalles_tecnicos                                            detalles_tecnicos?
  disponibilidad_tecnicos                                      disponibilidad_tecnicos[]
  direcciones                                                  direcciones[]
  refresh_tokens                                               refresh_tokens[]
  revoked_access_tokens                                        revoked_access_tokens[]
  solicitud_servicios_solicitud_servicios_id_clienteTousuarios solicitud_servicios[] @relation("solicitud_servicios_id_clienteTousuarios")
  solicitud_servicios_solicitud_servicios_id_tecnicoTousuarios solicitud_servicios[] @relation("solicitud_servicios_id_tecnicoTousuarios")
}

model refresh_tokens {
  id_refresh    String    @id @db.VarChar(50)
  id_usuario    String    @db.VarChar(50)
  token_hash    String    @unique @db.VarChar(64)
  expires_at    DateTime  @db.Timestamp(6)
  revoked_at    DateTime? @db.Timestamp(6)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  usuarios      usuarios  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, map: "fk_refresh_usuario")
}

model revoked_access_tokens {
  id_jti     String   @id @db.VarChar(50)
  id_usuario String   @db.VarChar(50)
  expires_at DateTime @db.Timestamp(6)
  revoked_at DateTime @default(now()) @db.Timestamp(6)
  usuarios   usuarios @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, map: "fk_revoked_access_usuario")
}
